{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Public marketing page for the apex domain. Static assets only, no Worker code.
  "name": "nowstocking-site",
  "compatibility_date": "2026-09-15",
  "assets": { "directory": "./public" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "nowstocking.com", "custom_domain": true },
    { "pattern": "www.nowstocking.com", "custom_domain": true }
  ]
}
