{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nowstocking",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],

  // Only the custom domain is exposed; it sits behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "pc-rv14a.nowstocking.com", "custom_domain": true }
  ],

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // Cloudflare Access: team domain (https://<team>.cloudflareaccess.com) and the app's AUD tag.
    "ACCESS_TEAM_DOMAIN": "https://drinkmorecoffee.cloudflareaccess.com",
    "ACCESS_AUD": "54134992e542d3184a0d89d3dc8d596af3ddd4b00a513d023081807922c6547a",
    "IMPORT_MODEL": "claude-opus-5",
    // Sender for label PDFs, sign-in codes and invites. The domain must be onboarded to Cloudflare Email Sending.
    "EMAIL_FROM": "no-reply@nowstocking.com",
    // "access": sign in through Cloudflare Access (self-hosted default).
    // "email": sign in with a one-time code sent by email (hosted). Needs the AUTH_SECRET secret.
    "AUTH_MODE": "access",
    // Photo pages Claude may read per account per month. 0 = unlimited.
    "PHOTO_PAGES_PER_MONTH": "0",
    // "single": self-hosted, everyone who gets past Access joins one account (first person is owner).
    // "open": hosted, each new user gets their own account.
    "SIGNUP_MODE": "single"
  },

  // Each warehouse's inventory lives in its own Durable Object with SQLite storage.
  "durable_objects": {
    "bindings": [{ "name": "WAREHOUSE", "class_name": "Warehouse" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Warehouse"] }],

  "send_email": [{ "name": "EMAIL" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventory",
      "database_id": "1412bc36-4878-4f61-a97b-9a37fb66c0c6",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    { "name": "nowstocking-import", "binding": "IMPORT_WORKFLOW", "class_name": "ImportWorkflow" }
  ],
  "r2_buckets": [
    { "binding": "IMPORTS", "bucket_name": "imports" }
  ],

  // Per-IP limit on sign-in requests (email sign-in only), so the form can't be used to spam inboxes.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],

  "observability": { "enabled": true },

  "env": {
    // The hosted service at app.nowstocking.com: email sign-in, open sign-up, a monthly photo limit.
    // Build and deploy with: CLOUDFLARE_ENV=hosted npm run build && npx wrangler deploy
    // Secrets: AUTH_SECRET, ANTHROPIC_API_KEY (npx wrangler secret put <NAME> --env hosted)
    "hosted": {
      "name": "nowstocking-app",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "app.nowstocking.com", "custom_domain": true }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "IMPORT_MODEL": "claude-opus-5",
        "EMAIL_FROM": "no-reply@nowstocking.com",
        "AUTH_MODE": "email",
        "PHOTO_PAGES_PER_MONTH": "20",
        "SIGNUP_MODE": "open"
      },
      "durable_objects": {
        "bindings": [{ "name": "WAREHOUSE", "class_name": "Warehouse" }]
      },
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nowstocking-app",
          "database_id": "3cf02f7d-cfaf-4f82-b3c4-ba72ab79c602",
          "migrations_dir": "migrations"
        }
      ],
      "workflows": [
        { "name": "nowstocking-app-import", "binding": "IMPORT_WORKFLOW", "class_name": "ImportWorkflow" }
      ],
      "r2_buckets": [
        { "binding": "IMPORTS", "bucket_name": "nowstocking-app-imports" }
      ],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
