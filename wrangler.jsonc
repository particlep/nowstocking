{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rv14a-inventory",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],

  // Only the custom domain is exposed; it sits behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "pc-rv14a.nowstocking.com", "custom_domain": true }
  ],

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // Cloudflare Access: team domain (https://<team>.cloudflareaccess.com) and the app's AUD tag.
    "ACCESS_TEAM_DOMAIN": "https://drinkmorecoffee.cloudflareaccess.com",
    "ACCESS_AUD": "54134992e542d3184a0d89d3dc8d596af3ddd4b00a513d023081807922c6547a",
    "IMPORT_MODEL": "claude-opus-5"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rv14a-inventory",
      "database_id": "9707f32f-6e44-4bc2-8af9-dc9e8e09f4f7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "IMPORTS", "bucket_name": "rv14a-imports" }
  ],

  "observability": { "enabled": true }
}
