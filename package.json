{
  "name": "nowstocking",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply rv14a-inventory --local",
    "db:migrate:remote": "wrangler d1 migrations apply rv14a-inventory --remote",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "deploy:site": "wrangler deploy --config site/wrangler.jsonc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "hono": "^4.13.9",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  },
  "description": "Parts inventory for kit builders: find it, scan it, pull it. A PWA on Cloudflare Workers, D1, R2 and Workflows.",
  "license": "MIT"
}
